// -*-Mode: C++;-*-
//

#ifndef UMBREON_SCENE_EXPORTER_QIF_INCLUDED
#define UMBREON_SCENE_EXPORTER_QIF_INCLUDED

#include <qsys/SceneExporter.qif>

runtime_class UmbreonSceneExporter extends SceneExporter
{
  client_hdr "UmbreonSceneExporter.hpp";
  client_name render::UmbreonSceneExporter;

  scriptable;
  smartptr;

  ////////////////////
  // Property definition
  //   (camera / width / height are inherited from SceneExporter)

  property boolean perspective => m_bPerspective;

  /// clip geometry to the camera slab near cutaway plane (z = slab/2)
  property boolean useClipZ => m_bUseClipZ;

  /// supersampling (antialiasing) factor; 1 = off
  property integer supersample => m_nSupersample;

  /// ambient-occlusion ray count per mesh hit; 0 = off
  property integer aoSamples => m_nAoSamples;

  /// ambient-occlusion occluder search radius (world units)
  property real aoDistance => m_dAoDistance;

  /// ambient-occlusion strength (0 = none, 1 = full)
  property real aoIntensity => m_dAoIntensity;

  /// cast shadows from the lights
  property boolean shadows => m_bShadows;

  /// shadow rays per light (>1 = soft area light)
  property integer shadowSamples => m_nShadowSamples;

  /// light angular radius in degrees (>0 = soft shadows)
  property real lightRadius => m_dLightRadius;

  //////////
  // edge / silhouette outline lines (CueMol toon edges)

  property boolean showEdgeLines => m_bEnableEdgeLines;

  property real creaseLimit => m_dCreaseLimit;

  property real edgeRise => m_dEdgeRise;

  //////////
  // transparent background: emit an RGBA PNG with alpha = coverage (POV
  // "_transpbg") so it can be composited over another image

  property boolean transparentBackground => m_bTransparentBackground;

  //////////
  // diffuse global illumination (umbreon pt1 path-traced integrator)

  /// enable diffuse global illumination
  property boolean useGI => m_bGI;

  /// GI gather samples per pixel (higher = less noise)
  property integer giSamples => m_nGiSamples;

  /// GI indirect intensity (indirect light gain)
  property real giIntensity => m_dGiIntensity;

  /// GI environment (sky) intensity multiplier
  property real giEnvIntensity => m_dGiEnvIntensity;

  /// denoise the GI indirect irradiance (Intel OIDN)
  property boolean giDenoise => m_bGiDenoise;

  ////////////////////
  // Asynchronous render (non-blocking, with progress + cancel).
  //
  // The synchronous write() (inherited from SceneExporter) blocks the caller
  // for the whole ray trace. For a responsive UI drive the render in three
  // phases instead: beginRender() -> poll getRenderProgress()/isRenderDone()
  // (optionally cancelRender()) -> endRender() to write the PNG. The heavy ray
  // trace runs on a background thread, so the polling calls return at once.

  /// Build the scene (on the calling thread) and start the ray trace on a
  /// background thread, returning immediately.
  void beginRender();

  /// Overall completion of the in-flight render in [0, 1] (0 when none).
  real getRenderProgress();

  /// Human-readable current render phase; "Idle" when no render is in flight.
  string getRenderPhaseName();

  /// True once the render has finished (or when none is in flight).
  boolean isRenderDone();

  /// Request cooperative cancellation of the in-flight render.
  void cancelRender();

  /// Join the render and write the result to the output path (set via setPath),
  /// unless it was cancelled. Releases the render state.
  void endRender();

  /// Whether the last endRender() ended because the render was cancelled (so no
  /// image was written).
  boolean wasRenderCancelled();

};

#endif
