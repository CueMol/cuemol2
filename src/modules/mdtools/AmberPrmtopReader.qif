// -*-Mode: C++;-*-
//
// AMBER prmtop topology reader scripting interface
//

#ifndef AMBER_PRMTOP_READER_QIF_INCLUDED
#define AMBER_PRMTOP_READER_QIF_INCLUDED

#include <qsys/ObjReader.qif>

runtime_class AmberPrmtopReader extends ObjReader
{
  client_hdr "AmberPrmtopReader.hpp";
  client_name mdtools::AmberPrmtopReader;

  scriptable;
  smartptr;

  /// Bond-building strategy for the explicit bonds in the prmtop file.
  enumdef bondmode {
    file = mdtools::AmberPrmtopReader::BONDMODE_FILE;
    hybrid = mdtools::AmberPrmtopReader::BONDMODE_HYBRID;
    autogen = mdtools::AmberPrmtopReader::BONDMODE_AUTOGEN;
  }
  property enum bondmode => redirect(getBondMode, setBondMode);
  default bondmode = "file";

};

#endif
