// -*-Mode: C++;-*-
//
// MD trajectory block object
//

#ifndef TRAJ_BLOCK_QIF_INCLUDED
#define TRAJ_BLOCK_QIF_INCLUDED

#include <qsys/Object.qif>

runtime_class TrajBlock extends Object
{
  client_hdr "TrajBlock.hpp";
  client_name mdtools::TrajBlock;

  scriptable;
  smartptr;

  /// Number of coordinate frames in this block.
  property integer nframe => redirect(getSize, XX) (readonly);

  /// Start frame index of this block within the parent trajectory.
  property integer start_index => redirect(getStartIndex, XX) (readonly);
};

#endif
