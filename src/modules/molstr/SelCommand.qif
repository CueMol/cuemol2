#ifndef SEL_COMMAND_QIF_INCLUDED
#define SEL_COMMAND_QIF_INCLUDED

#include "MolSelection.qif"

runtime_class SelCommand extends MolSelection
{
  client_hdr "SelCommand.hpp";
  client_name molstr::SelCommand;

  scriptable;
  cloneable;
  smartptr;

  // integer isSelectedMol(object<MolCoord$> pobj);
  // integer isSelectedChain(object<MolChain$> pchain);
  // integer isSelectedResid(object<MolResidue$> presid);
  // boolean isSelected(object<MolAtom$> patom);
  // boolean isEmpty();

  /// Compile selectio command cmd, in the context uid
  boolean compile(string cmd, integer uid);

  string dumpNodes();

  /// Equivalent, usually shorter expression (for expressions built by
  /// wrapping the current one)
  string simplify();

  /// not (this), simplified; "*" for an empty selection
  string invertSimplified();

  /// bysidech (this), or the inside when this is bysidech already
  string toggleSidechain();

  /// this around dist (byres when byres), replacing an around at the root
  string rewriteAround(real dist, boolean byres);

  property string error_msg => redirect(getErrorMsg, setErrorMsg);
  default error_msg = "";
  
};

#endif

