// -*-Mode: C++;-*-
//
//  Direct molecular surface renderer scripting interface
//

#ifndef DIRECT_SURF_RENDERER_QIF_INCLUDED
#define DIRECT_SURF_RENDERER_QIF_INCLUDED

#include "DirectSurfRendererBase.qif"

runtime_class DirectSurfRenderer extends DirectSurfRendererBase
{
  client_hdr "DirectSurfRenderer.hpp";
  client_name surface::DirectSurfRenderer;

  scriptable;
  smartptr;
  cloneable;

  /// Surface calculation algorithm. "meshms" builds the SES analytically and
  /// falls back to "distfield" where it is unavailable (see the class doc).
  enumdef surfalgor {
    edtsurf = surface::DirectSurfRenderer::DS_EDTSURF;
    distfield = surface::DirectSurfRenderer::DS_DISTFIELD;
    meshms = surface::DirectSurfRenderer::DS_MESHMS;
  }
  property enum surfalgor => redirect(getSurfAlgor, setSurfAlgor);
  default surfalgor = "distfield";

};

#endif
