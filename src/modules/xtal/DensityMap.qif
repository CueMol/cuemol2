// -*-Mode: C++;-*-
//
// Electron density map scripting interface
//

#ifndef DENSITY_MAP_QIF_INCLUDED
#define DENSITY_MAP_QIF_INCLUDED

#include <qsys/ScalarObject.qif>
#include <qsys/View.qif>

runtime_class DensityMap extends ScalarObject
{
  client_hdr "DensityMap.hpp";
  client_name xtal::DensityMap;

  scriptable;
  smartptr;

  // Properties
  //property real den_sigma => redirect(getRmsdDensity, XXX) (readonly);
  //property real den_min => redirect(getMinDensity, XXX) (readonly);
  //property real den_max => redirect(getMaxDensity, XXX) (readonly);
  //property real den_mean => redirect(getMeanDensity, XXX) (readonly);

  /// Map kind: auto (detected from the file header), crystallographic
  /// (periodic) or cryo-EM (non-periodic)
  enumdef map_type {
    auto = xtal::DensityMap::MAPTYPE_AUTO;
    xtal = xtal::DensityMap::MAPTYPE_XTAL;
    em = xtal::DensityMap::MAPTYPE_EM;
  }
  property enum map_type => redirect(getMapType, setMapType);
  default map_type = "auto";

  /// Effective map kind ("xtal" or "em")
  property string map_type_resolved => redirect(getMapTypeResolvedStr, XXX) (readonly);

  /// Map origin in orthogonal coordinates (angstrom)
  property object<Vector> origin => redirect(getOrigin, XXX) (readonly);

  // Methods
  //string getNormHistogramJSON();
  //string getHistogramJSON(real min, real max, integer nbin);

  void fitView(object<View$> pView, boolean dummy);

  /// Density level enclosing the top fraction of the grid points
  real getLevelAtTopFraction(real frac);

};

#endif

