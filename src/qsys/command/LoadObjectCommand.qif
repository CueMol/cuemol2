// -*-Mode: C++;-*-

#ifndef LOAD_OBJECT_COMMAND_QIF
#define LOAD_OBJECT_COMMAND_QIF

#include <qsys/Object.qif>
#include <qsys/View.qif>

#include "Command.qif"

runtime_class LoadObjectCommand extends Command
{
    client_hdr "LoadObjectCommand.hpp";
    client_name qsys::LoadObjectCommand;
    dllexport QSYS_API;

    scriptable;
    smartptr;
    cloneable;

    //////////
    // properties (input)

    /// Target scene (mandatory)
    property object<Scene$> target_scene => m_pTargScene;

    /// File path to load
    property string file_path => m_filePath;
    default file_path = "";

    /// Object name (optional)
    property string object_name => m_objectName;
    default object_name = "";

    /// File format (optional)
    property string file_format => m_fileFmt;
    default file_format = "";

    /// When true, the reader is picked purely from content sniffing
    /// (file extension is ignored). When false, the extension narrows
    /// the candidate set first and sniff disambiguates only when
    /// multiple readers share that extension.
    property boolean content_first => m_bContentFirst;
    default content_first = false;

    /// Caps how many bytes each reader's canHandleContent() is allowed
    /// to consume during sniff. 0 (default) means unbounded -- the
    /// streaming sniffer reads each candidate's stream until it returns
    /// a verdict or hits EOF. Set a positive value to bound sniffing
    /// against pathological / very large inputs.
    property integer max_sniff_bytes => m_nMaxSniffBytes;
    default max_sniff_bytes = 0;

    /// Setter for the target scene that bypasses the property setter
    /// path. The auto-generated setter for `target_scene` routes through
    /// setPropHelper -> setupParentData which clobbers the scene's
    /// parent linkage (m_thisname / m_rootuid) and breaks nested undo
    /// records. Non-UXP callers should prefer this method.
    void setTargetScene(object<Scene$> pScene);

    //////////
    // properties (output)

    /// resulting object (new or same as targObject)
    property object<Object$> result_object => m_pResObj (readonly);

};

#endif
