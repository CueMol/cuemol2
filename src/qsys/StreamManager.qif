// -*-Mode: C++;-*-
//
// $Id: StreamManager.qif,v 1.8 2010/12/15 00:19:08 rishitani Exp $

#ifndef STREAM_MANAGER_QIF_INCLUDED
#define STREAM_MANAGER_QIF_INCLUDED

#include <qlib/ByteArray.qif>
#include <qlib/LScrObject.qif>
#include "ObjReader.qif"

runtime_class StreamManager
{
  client_hdr "StreamManager.hpp";
  client_name qsys::StreamManager;

  scriptable;

  // 
  singleton;

  string getReaderInfoJSON();
  string getWriterInfoJSON();
  string getInfoJSON2();

  // string getInitRendererNames(string reader_name);
  string findCompatibleWriterNamesForObj(integer objid);

  object<InOutHandler$> createHandler(string name, integer category);

  // Content sniffing: return the first reader nickname whose
  // canHandleContent() returns YES. `nicknames` is a comma-separated
  // filter list (empty string = every registered reader of `category`).
  // When `supportCompression` is true, gzip / xz magic bytes are
  // detected and the head is decompressed transparently. Each reader
  // first sees 64 KiB; a reader cut off by that budget while still
  // undecided is retried with 8x the budget, up to the `maxBytes`
  // ceiling (0 = no ceiling: retry until EOF or a verdict). Returns ""
  // when no reader matches.
  string searchReaderByContent(string path, string nicknames, integer category, boolean supportCompression, integer maxBytes);

  // Content sniffing (multi-match): return all reader nicknames whose
  // canHandleContent() returns YES as a comma-separated string.
  // `maxBytes` behaves as in searchReaderByContent. Reader nicknames
  // are alphanumeric so no escaping is needed.
  string searchReadersByContent(string path, string nicknames, integer category, boolean supportCompression, integer maxBytes);

  // Asynchronous data loading
  integer loadObjectAsync(object<ObjReader$>);
  void supplyDataAsync(integer, object<ByteArray$>, integer);
  object<Object$> waitLoadAsync(integer);

  // XML-string serialization
  object<ByteArray$> toXML(object<LScrObject$>);
  object<ByteArray$> toXML2(object<LScrObject$>, string type_ovwr);
  // array ver
  object<ByteArray$> arrayToXML(array);
  object<ByteArray$> rendGrpToXML(array, string);

  object<LScrObject$> fromXML(object<ByteArray$>, integer);
  array rendArrayFromXML(object<ByteArray$>, integer);
  // array objArrayFromXML(object<ByteArray$>, integer);

  // InOutHander category IDs
  property integer OBJECT_READER => redirect(getCAT_OBJREADER, XXX) (readonly);
  property integer OBJECT_WRITER => redirect(getCAT_OBJWRITER, XXX) (readonly);
  property integer SCENE_READER => redirect(getCAT_SCEREADER, XXX) (readonly);
  property integer SCENE_WRITER => redirect(getCAT_SCEWRITER, XXX) (readonly);

};

#endif
// STREAM_MANAGER_QIF_INCLUDED
