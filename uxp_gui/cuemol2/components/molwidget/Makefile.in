

# macOS specific install script
ifeq (Darwin, $(OS_ARCH))

PROGRAMS_DEST = $(DIST)/bin/components
dist_dest = $(DIST)/$(MOZ_MACBUNDLE_NAME)

#.PHONY: repackage
#tools repackage:: $(PROGRAM)
libs::
	echo '$(srcdir)'
	echo '$(PROGRAMS_DEST)/$(SHARED_LIBRARY)'
	echo 'CUEMOL_DEPLIB_DIRS=$(CUEMOL_DEPLIB_DIRS)'
	$(PYTHON) --version
	$(PYTHON) $(srcdir)/install_dylibs.py -i '$(PROGRAMS_DEST)/$(SHARED_LIBRARY)' --search_path=$(CUEMOL_DEPLIB_DIRS):$(CUEMOL_DIR)/lib --out_dir '$(DIST)/bin'
	if [ -d "$(CUEMOL_DIR)/data/python" ] ; then \
      mkdir -p $(dist_dest)/Contents/Resources/data/ ; \
	  cp -R $(CUEMOL_DIR)/data/python $(dist_dest)/Contents/Resources/data/ ; \
	else \
	  echo "No python data dir found in $(CUEMOL_DIR)/data/python" ; \
	fi
	if [ ! -d "$(dist_dest)/Contents/Resources/python" ] ; then \
	  mkdir -p $(dist_dest)/Contents/Resources/python ; \
	  touch $(dist_dest)/Contents/Resources/python/dummy ; \
	fi

# @$(foreach V,$(sort $(.VARIABLES)),$(if $(filter-out environment% default automatic,$(origin $V)),$(warning $V=$($V) ($(value $V)))))

endif
ifeq (WINNT,$(OS_ARCH))
libs::
	echo 'srcdir: $(srcdir)'
	echo 'DIST: $(dist)'
	echo 'CUEMOL_DEPLIB_DIRS=$(CUEMOL_DEPLIB_DIRS)'
	mkdir -p $(DIST)/bin/python
	touch $(DIST)/bin/python/dummy
	cp $(CUEMOL_DEPLIB_DIRS)/*-mt-x64-*.dll $(DIST)/bin/
	cp $(CUEMOL_DIR)/bin/*.dll $(DIST)/bin/
endif
