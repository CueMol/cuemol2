# Single source of truth for external versions used by build_scripts.
# Plain KEY=VALUE (no quotes/spaces); '#' starts a comment.
# bash: `. <path>/deplibs.env`   cmd: `call <path>\deplibs_env.bat`

# === Prebuilt deplibs bundle (owned by download_deplibs) ===
# Bumping DEPLIBS_VERSION changes the lib versions packed in the per-OS bundle;
# the bundled-lib *_VER below must match the dir names it extracts to.
DEPLIBS_VERSION=v0.1.0

# Libs from the deplibs bundle, referenced by build_libcuemol2 by dir name.
# Keep in sync with DEPLIBS_VERSION. GLEW differs per-OS (separate per-OS bundle).
FFTW_VER=3.3.10
LCMS2_VER=2.17
GLEW_VER=2.2.0
GLEW_VER_WINDOWS=2.2.0
# LZMA (xz) is only consumed by the Windows libcuemol2 build.
LZMA_VER=5.2.12
# oneTBB + Embree static libs (added in v0.0.9). Embree is built with TBB tasking
# (EMBREE_TASKING_SYSTEM=TBB), so libcuemol2 and umbreon must resolve TBB to this
# single bundled copy (do not also fetch a separate oneTBB).
TBB_VER=2023.0.0
EMBREE_VER=4.4.1
# Intel Open Image Denoise (CPU-only static build, added in v0.1.0). Consumed by
# the umbreon OIDN backend (UMBREON_WITH_OIDN); linked PUBLIC into libumbreon, so
# libcuemol2 must resolve the same bundled copy at final link.
OIDN_VER=2.5.0

# === Build deps referenced by build scripts (provisioned into BASEDIR) ===
# BOOST_VER: dir name suffix (boost_<BOOST_VER>); BOOST_INC_VER: versioned include
# subdir suffix (boost-<BOOST_INC_VER>), used by the Windows UXP mozconfig.
BOOST_VER=1_84_0
BOOST_INC_VER=1_84
CGAL_VER=6.1

# === External packages (owned by download_extpkgs; consumers use dir name) ===
APBSPKG_VER=v0.0.2
POVRAYPKG_VER=v0.0.5
# Windows ships apbs+povray+ffmpeg as one prebuilt bundle asset (hosted in the
# povray_build repo) instead of the three separate downloads, so it carries its
# own version. Owned by download_extpkgs/run_win.sh.
EXTPKGS_VER_WINDOWS=v0.0.5
FFMPEG_DIST_ARM64=ffmpeg61arm
FFMPEG_DIST_X64=ffmpeg61intel

# === umbreon (Embree ray-tracing backend; built from source, not bundled) ===
# Git ref of CueMol/umbreon that the umbreon_smoke CI checks out and installs into
# the deplibs prefix (build_umbreon_posix). Local dev installs its own working
# copy instead (task install_umbreon). Pin to a commit SHA for reproducibility
# once umbreon stabilizes.
UMBREON_GIT_REF=main

# === MeshMS (analytic SES surface backend; built from source, not bundled) ===
# Git ref of CueMol/MeshMS that CI checks out and installs into the deplibs
# prefix (build_meshms_posix). Local dev installs its own working copy instead
# (task install_meshms). Pin to a commit SHA for reproducibility once MeshMS
# stabilizes.
MESHMS_GIT_REF=main

# === UXP GUI prebuilt platform (owned by build_uxpgui) ===
UXP_VERSION=v0.0.1
UXP_TGZ=RB_20231106.tar.gz

# === Third-party source mirror (hosted by CueMol/build_scripts, fixed tag) ===
# Upstream tarballs whose origin hosts are unreliable are mirrored into a
# fixed-tag release of CueMol/build_scripts, so CI never fetches them from the
# origin host. The tag is immutable (unlike DEPLIBS_VERSION); assets are
# refreshed by the "Mirror third-party sources" workflow in that repository.
THIRDPARTY_MIRROR_URL=https://github.com/CueMol/build_scripts/releases/download/thirdparty-mirror

# autoconf 2.13 is built from source by download_deplibs and provides autoconf213,
# required by the macOS UXP GUI build. Upstream is ftp.gnu.org, which is often
# unreachable; the checksum below is GNU's published sha256 for the tarball.
AUTOCONF213_VER=2.13
AUTOCONF213_SHA256=f0611136bee505811e9ca11ca7ac188ef5323a8e2ef19cffd3edb3cf08fd791e
