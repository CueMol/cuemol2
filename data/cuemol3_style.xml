<?xml version="1.0" encoding="utf-8"?>

<!--
  CueMol3 (tritium) additions to default_style.xml.

  CueMol3 loads this file after default_style.xml (see sysconfig_cuemol3.xml);
  CueMol2 (UXP) does not load it, so CueMol2 keeps the v2.4.1 look. A style
  here is looked up before the one of the same name in default_style.xml, one
  property at a time: a property this file leaves out falls back to
  default_style.xml.
-->
<styles id="cuemol3">

  <!-- Slimmer ribbon than CueMol2's, with a coil width of its own -->
  <style id="DefaultRibbon" type="renderer" desc="Default">
    <helix tuber="6.5" width="0.18"/>
    <sheet tuber="6.5" width="0.18"/>
    <coil width="0.2"/>
  </style>

  <!-- Smaller bases and a round-square backbone tube -->
  <style id="DefaultNucl" type="renderer" base_size="0.3" base_thick="0.3">
    <section type="roundsquare" width="0.4"/>
  </style>

  <!-- PyMOL's auto_show_classified: polymer as cartoon (CueMol's ribbon), organic residues
       (those with carbon) as sticks, inorganic ones as spheres, water as
       lines (crosses). The default for a molecule loaded without a renderer
       (console / MCP / agent). -->
  <style id="DefaultPymRendPreset" type="MolCoord-rendpreset" desc="PyMOL-like preset">
    <renderer type="ribbon" sel="protein" style="DefaultRibbon,DefaultHSCPaint"/>
    <renderer type="nucl" sel="nucleic" style="DefaultNucl"/>
    <renderer type="ballstick" sel="ligand&amp;(byres (ligand&amp;elem C))" style="StickBallStick,DefaultCPKColoring"/>
    <renderer type="cpk" sel="ligand&amp;!(byres (ligand&amp;elem C))" style="DefaultCPK,DefaultCPKColoring"/>
    <renderer type="simple" sel="water" style="DefaultSimple,DefaultCPKColoring"/>
  </style>

  <!-- Palette themes for the default painting of a loaded molecule, as
       <theme>_<n> named colors. The n-th molecule loaded into a scene takes
       the theme's n-th colour (cycling over however many it has), and its
       structures are modifiers of it. The colour used is copied into the
       scene's own style set on load, so a saved scene carries it. Values
       only (a named color cannot refer to another one). -->

  <!-- The theme new molecules are painted with. Override it in a user style
       file, or in a scene's style set, with the same tag. -->
  <palette id="default_paint" value="okabeito"/>

