    "@types/bindings": "^1.5.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "node-addon-api": "^8.6.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
