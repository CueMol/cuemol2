{
  "name": "@cuemol/react-gui",
  "productName": "CueMol3",
  "description": "CueMol: macromolecular structure visualization",
  "homepage": "https://www.cuemol.org/",
  "author": "CueMol Project <info@cuemol.org>",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:style": "stylelint 'src/**/*.css'",
    "lint:comments": "node scripts/check-comment-ascii.mjs",
    "package:mac": "bash ../packaging/package-mac.sh",
    "package:win": "bash ../packaging/package.sh --win --x64",
    "package:dir": "CUEMOL_RELEASE=1 electron-vite build && electron-builder --dir --arm64"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@blueprintjs/core": "^5.13.0",
    "@blueprintjs/icons": "^5.13.0",
    "@cuemol/core": "workspace:*",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.39.3",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@use-gesture/react": "^10.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "allotment": "^1.20.2",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-complex-tree": "^2.3.3",
    "react-dom": "^18.3.1",
    "react-tabs": "^6.0.2",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.6"
  }
}
