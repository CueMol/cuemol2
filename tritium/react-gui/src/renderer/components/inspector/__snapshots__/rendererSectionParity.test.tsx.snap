// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderer Properties page > anisou / default 1`] = `
{
  "Anisotropic displacement": {
    "rows": [
      "Draw disc [switch] {resettable} value="on"",
      "Disc scale [drag-numeric] {resettable}",
      "Disc thickness [drag-numeric] {resettable}",
    ],
    "writes": [
      "Draw disc -> set drawdisc=false",
      "Disc scale -> set discscale=1.15",
      "Disc thickness -> set discthick=0.15",
    ],
  },
  "Atoms and bonds": {
    "rows": [
      "Detail [select] {resettable} options=[2|3|4|8|16|32] selected=3",
      "Bond width [drag-numeric] {resettable}",
      "Atom radius [drag-numeric] {resettable}",
      "Show ring [switch] {resettable} value="on"",
      "Thickness [drag-numeric] {resettable,disabled}",
      "Ring color [color] {resettable,disabled} value="#FFFFBF"",
    ],
    "writes": [
      "Detail -> set detail=2",
      "Bond width -> set bondw=0.21",
      "Atom radius -> set sphr=0.31",
      "Show ring -> set ring=true",
      "Thickness -> (nothing)",
      "Ring color -> (nothing)",
    ],
  },
  "Basic settings": {
    "rows": [
      "Name [text] value=""",
      "Selection [text] value=""",
      "Visible [switch] {resettable} value="on"",
      "Locked [switch] {resettable} value="on"",
      "Material [select] {resettable} options=[] selected=",
      "Opacity [drag-numeric] {resettable}",
    ],
    "writes": [
      "Name -> set name="x"",
      "Selection -> (nothing)",
      "Visible -> set visible=false",
      "Locked -> set locked=true",
      "Material -> (not driven)",
      "Opacity -> (nothing)",
    ],
  },
  "Edge lines": {
    "rows": [
      "Edge type [select] {resettable} options=[none|edges|silhouette] selected=none",
      "Width [drag-numeric] {resettable,disabled}",
      "Color [color] {resettable,disabled} value="#000000"",
    ],
    "writes": [
      "Edge type -> set egtype="edges"",
      "Width -> (nothing)",
      "Color -> (nothing)",
    ],
  },
}
`;

exports[`renderer Properties page > atomintr / caps-arrow 1`] = `
{
  "3D tube": {
    "rows": [
      "Detail [select] {resettable} options=[2|4|5|8|16|32] selected=5",
      "Start cap [select] {modified,resettable} options=[arrow|flat|sphere] selected=arrow",
      "End cap [select] {modified,resettable} options=[arrow|flat|sphere] selected=arrow",
      "Arrow height [drag-numeric] {resettable}",
      "Arrow width [drag-numeric] {resettable}",
    ],
    "writes": [
      "Detail -> set detail=2",
      "Start cap -> set captype_start="flat"",
      "End cap -> set captype_end="flat"",
      "Arrow height -> set arrowheight=1.1",
      "Arrow width -> set arrowwidth=2.1",
    ],
  },
  "Basic settings": {
    "rows": [
      "Name [text] value=""",
      "Visible [switch] {resettable} value="on"",
      "Locked [switch] {resettable} value="on"",
      "Material [select] {resettable} options=[] selected=",
      "Opacity [drag-numeric] {resettable}",
    ],
    "writes": [
      "Name -> set name="x"",
      "Visible -> set visible=false",
      "Locked -> set locked=true",
      "Material -> (not driven)",
      "Opacity -> (nothing)",
    ],
  },
  "Dashed line": {
    "rows": [],
    "writes": [],
  },
  "Edge lines": {
    "rows": [
      "Edge type [select] {resettable} options=[none|edges|silhouette] selected=none",
      "Width [drag-numeric] {resettable,disabled}",
      "Color [color] {resettable,disabled} value="#000000"",
    ],
    "writes": [
      "Edge type -> set egtype="edges"",
      "Width -> (nothing)",
      "Color -> (nothing)",
    ],
  },
  "Interaction": {
    "rows": [
      "Mode [select] {resettable} options=[fancy|simple] selected=fancy",
      "Width [drag-numeric] {resettable}",
      "Color [color] {resettable} value="#FFFF00"",
      "Show label [switch] {resettable} value="on"",
    ],
    "writes": [
      "Mode -> set mode="simple"",
      "Width -> set width=0.15",
      "Color -> (nothing)",
      "Show label -> set showlabel=true",
    ],
  },
  "Value label": {
    "rows": [
      "Font size [drag-numeric] {resettable,disabled}",
      "Font name [text] {resettable,disabled} value="sans-serif"",
      "Font style [select] {resettable,disabled} options=[normal|italic] selected=normal",
      "Font weight [select] {resettable,disabled} options=[normal|bold] selected=normal",
    ],
    "writes": [
      "Font size -> (nothing)",
      "Font name -> set font_name="sans-serifx"",
      "Font style -> set font_style="italic"",
      "Font weight -> set font_weight="bold"",
    ],
  },
}
`;

