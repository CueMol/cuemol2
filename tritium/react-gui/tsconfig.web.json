{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/plugins/**/*"],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"],
      // Built-in plugins (src/plugins/<id>/). Only the plugin host imports
      // the registry barrel; core code must not reach into a plugin.
      "@plugins/*": ["src/plugins/*"],
      // Not for our own code -- use @renderer/*. @cuemol/core maps `@/*` onto
      // its own src/ (tritium/core/tsconfig.json) and we deep import core
      // TypeScript sources, so core's files are part of this program and their
      // internal `@/...` specifiers have to resolve. ESLint forbids `@/...` in
      // react-gui sources so the two never blur together.
      "@/*": ["../core/src/*"]
    }
  }
}
